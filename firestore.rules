rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Photos ──────────────────────────────────────────────────────────
    // Anyone can read (public gallery). Only authenticated admin can write.
    match /photos/{photoId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ── Posts / Blog ─────────────────────────────────────────────────────
    // Anyone can read (public blog). Only authenticated admin can write.
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ── Insights / Analytics ─────────────────────────────────────────────
    // Anyone can write (page-view counters fire for all visitors).
    // Only authenticated admin can read analytics.
    match /insights/{insightId} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    // ── Everything else ───────────────────────────────────────────────────
    // Deny by default — nothing else should be accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
