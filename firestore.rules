rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Photos rules
    match /photos/{photoId} {
      allow read, write: if true;
    }
    
    // Posts rules
    match /posts/{postId} {
      allow read, write: if true;
    }
    
    // Insights rules
    match /insights/{insightId} {
      allow read, write: if true;
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
